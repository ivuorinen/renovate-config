      "matchPackageNames": [
        "github.com/google/yamlfmt/cmd/yamlfmt",
        "google/yamlfmt"
      ],
      "semanticCommitScope": "tooling"
    },
    {
      "commitMessagePrefix": "chore(tooling): ",
      "group": {
        "commitMessageTopic": "{{{groupName}}}{{#unless commitMessageExtra}} to {{#each (distinct (lookupArray upgrades 'prettyNewVersion'))}}{{#unless @first}}, {{/unless}}{{{.}}}{{/each}}{{/unless}}"
      },
