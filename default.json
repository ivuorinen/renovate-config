{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assigneesFromCodeOwners": true,
  "automergeStrategy": "squash",
  "commitBody": "Signed-off-by: {{{gitAuthor}}}",
  "commitMessageAction": "update",
  "commitMessageExtra": " ({{#if isPinDigest}}{{{newDigestShort}}}{{else}}{{#if (equals updateType \"digest\")}}{{{currentDigestShort}}} → {{{newDigestShort}}}{{else}}{{{currentVersion}}} → {{{newVersion}}}{{/if}}{{/if}})",
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "description": [
        "Upgrade Dockerfile ENV and FROM variables base on regex. ",
        "See https://docs.renovatebot.com/configuration-options/#matchstringsstrategy"
      ],
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "ENV [A-Z][A-Z0-9_]*_VERSION=(?<currentValue>.*) # (?<datasource>.*?)/(?<depName>.*?)(\\&versioning=(?<versioning>.*?))?\\s"
      ],
      "matchStringsStrategy": "any"
    },
    {
      "customType": "regex",
      "description": [
        "Track tool versions in Makefiles via '# renovate: datasource=X depName=Y' comments. ",
        "See https://docs.renovatebot.com/configuration-options/#matchstringsstrategy"
      ],
      "managerFilePatterns": [
        "/(^|/)Makefile$/",
        "/\\.mk$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:[^\\n]*?[ \\t]versioning=(?<versioning>\\S+))?[^\\n]*\\n[A-Za-z_][A-Za-z0-9_]*\\s*[:+?]?=\\s*(?<currentValue>v?\\d+\\.\\d+(\\.\\d+)?\\S*)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    }
  ],
  "dependencyDashboardLabels": [
    "no-stale"
  ],
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "description": "Renovate config for projects ivuorinen manages",
  "digest": {
    "enabled": false
  },
  "extends": [
    "config:recommended",
    ":enableVulnerabilityAlerts",
    ":label(dependencies)",
    ":preserveSemverRanges",
    ":semanticCommits",
    ":timezone(Europe/Helsinki)",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    "security:minimumReleaseAgeNpm",
    "schedule:nonOfficeHours"
  ],
  "git-submodules": {
    "enabled": true
  },
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/*.sops.*",
    "**/.archive/**",
    "**/testdata/**"
  ],
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "addLabels": [
        "type/major"
      ],
      "commitMessagePrefix": "chore(deps)!: ",
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "automerge": true,
      "automergeType": "branch",
      "description": [
        "Automerge non-breaking version bumps via branch strategy. ",
        "'digest' is deliberately excluded: digest updates bypass minimumReleaseAge ",
        "entirely (Renovate pushes them outside filterInternalChecks), so automerging ",
        "them would silently accept a force-moved third-party action tag — the exact ",
        "attack helpers:pinGitHubActionDigests exists to prevent. Third-party digest ",
        "updates therefore raise a reviewable PR; only ivuorinen/actions digests ",
        "automerge, via the trusted-source rule at the end of this array."
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "description": [
        "Exempt git submodules from the global minimumReleaseAge hold. The git-refs ",
        "datasource returns no releaseTimestamp, and minimumReleaseAgeBehaviour defaults ",
        "to 'timestamp-required', so an unexempted submodule update is marked pending ",
        "forever and no branch is ever created. Every other datasource keeps the ",
        "fail-closed 3-day hold."
      ],
      "matchManagers": [
        "git-submodules"
      ],
      "minimumReleaseAge": null
    },
    {
      "commitMessageTopic": "chart {{depName}}",
      "matchDatasources": [
        "helm"
      ]
    },
    {
      "commitMessageTopic": "image {{depName}}",
      "matchDatasources": [
        "docker"
      ]
    },
    {
      "addLabels": [
        "type/minor"
      ],
      "matchUpdateTypes": [
        "minor"
      ]
    },
    {
      "addLabels": [
        "type/patch"
      ],
      "matchUpdateTypes": [
        "patch"
      ]
    },
    {
      "addLabels": [
        "type/digest"
      ],
      "matchUpdateTypes": [
        "digest"
      ]
    },
    {
      "addLabels": [
        "renovate/container"
      ],
      "matchDatasources": [
        "docker"
      ]
    },
    {
      "addLabels": [
        "renovate/helm"
      ],
      "matchDatasources": [
        "helm"
      ]
    },
    {
      "addLabels": [
        "renovate/ansible"
      ],
      "matchDatasources": [
        "galaxy",
        "galaxy-collection"
      ]
    },
    {
      "addLabels": [
        "renovate/terraform"
      ],
      "matchDatasources": [
        "terraform-provider"
      ]
    },
    {
      "addLabels": [
        "renovate/github-release"
      ],
      "matchDatasources": [
        "github-releases",
        "github-tags"
      ]
    },
    {
      "addLabels": [
        "renovate/github-action"
      ],
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitScope": "actions"
    },
    {
      "addLabels": [
        "renovate/pip"
      ],
      "matchDatasources": [
        "pypi"
      ]
    },
    {
      "groupName": "devDependencies (non-major)",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ]
    },
    {
      "description": [
        "Re-enable digest updates for ALL GitHub Actions. ",
        "helpers:pinGitHubActionDigests pins every action to a SHA, but the global ",
        "digest.enabled:false would otherwise freeze those pinned SHAs forever when ",
        "a floating tag (e.g. @v1) moves to a new commit. This keeps digests disabled ",
        "for Docker and everything else, while letting all actions stay current. ",
        "Enabling a digest update is not the same as automerging it: third-party ",
        "action digests raise a reviewable PR, and only ivuorinen/actions digests ",
        "inherit automerge from the trusted-source rule at the end of this array."
      ],
      "enabled": true,
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest"
      ]
    },
    {
      "groupName": "development tools",
      "matchFileNames": [
        "**/Makefile",
        "**/*.mk"
      ],
      "matchManagers": [
        "custom.regex"
      ]
    },
    {
      "groupName": "eslint",
      "matchPackageNames": [
        "/eslint/"
      ]
    },
    {
      "groupName": "illuminate",
      "matchPackageNames": [
        "/illuminate/"
      ]
    },
    {
      "groupName": "phpstan",
      "matchPackageNames": [
        "/phpstan/",
        "/larastan/"
      ]
    },
    {
      "groupName": "semantic-release",
      "matchPackageNames": [
        "/semantic-release/"
      ]
    },
    {
      "groupName": "stylelint",
      "matchPackageNames": [
        "/stylelint/"
      ]
    },
    {
      "groupName": "tailwind",
      "matchPackageNames": [
        "/tailwind/"
      ]
    },
    {
      "groupName": "vite",
      "matchPackageNames": [
        "/vite/"
      ]
    },
    {
      "groupName": "vue",
      "matchPackageNames": [
        "/vue/"
      ]
    },
    {
      "automerge": true,
      "automergeType": "pr",
      "description": [
        "Fast-track first-party packages. This rule and the one below MUST stay last ",
        "in packageRules: the ecosystem groups above match on unanchored regexes ",
        "(/eslint/, /stylelint/, /semantic-release/) which also match ",
        "@ivuorinen/eslint-config, @ivuorinen/stylelint-config, @ivuorinen/stylelint-a11y ",
        "and @ivuorinen/semantic-release-config. Renovate applies packageRules in array ",
        "order and later matches win, so placed earlier this groupName was silently ",
        "overwritten for a third of the scope."
      ],
      "groupName": "@ivuorinen packages",
      "internalChecksFilter": "flexible",
      "matchPackageNames": [
        "@ivuorinen/**"
      ],
      "minimumReleaseAge": null,
      "prCreation": "immediate",
      "prPriority": 10,
      "schedule": [
        "at any time"
      ]
    },
    {
      "automerge": true,
      "automergeType": "pr",
      "description": [
        "Fast-track first-party actions. Also the trusted source whose digest updates ",
        "are allowed to automerge — third-party action digests deliberately do not."
      ],
      "groupName": "@ivuorinen actions",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "ivuorinen/actions",
        "ivuorinen/actions/**"
      ],
      "minimumReleaseAge": null,
      "prCreation": "immediate",
      "prPriority": 10,
      "schedule": [
        "at any time"
      ]
    }
  ],
  "postUpdateOptions": [
    "bundlerConservative",
    "composerWithAll",
    "gomodUpdateImportPaths",
    "npmDedupe",
    "pnpmDedupe",
    "yarnDedupeHighest"
  ],
  "prHourlyLimit": 5,
  "pre-commit": {
    "enabled": true
  },
  "reviewersFromCodeOwners": true,
  "separateMultipleMajor": true
}
