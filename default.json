{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assigneesFromCodeOwners": true,
  "automergeStrategy": "squash",
  "commitMessageAction": "update",
  "commitMessageExtra": " ({{#if isPinDigest}}{{{newDigestShort}}}{{else}}{{#if (equals updateType \"digest\")}}{{{currentDigestShort}}} → {{{newDigestShort}}}{{else}}{{{currentVersion}}} → {{{newVersion}}}{{/if}}{{/if}})",
  "customManagers": [
    {
      "customType": "regex",
      "description": [
        "Track tool versions in Dockerfile ENV lines via '# datasource/depName' comments. ",
        "Carries no datasourceTemplate on purpose: a '<field>Template' wins over the ",
        "capture group of the same name — createDependency() takes the template branch ",
        "first and the capture only as its else — so the 'docker' template that used to ",
        "sit here made the (?<datasource>) capture dead code. Every annotated ENV resolved ",
        "against the Docker datasource instead of the one its comment named: ",
        "'# golang-version/go' was looked up as the image 'go' and the pin never moved, ",
        "silently. FROM lines are left to the built-in dockerfile manager. ",
        "See https://docs.renovatebot.com/configuration-options/#matchstringsstrategy"
      ],
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "ENV [A-Z][A-Z0-9_]*_VERSION=(?<currentValue>.*) # (?<datasource>.*?)/(?<depName>.*?)(\\&versioning=(?<versioning>.*?))?\\s"
      ],
      "matchStringsStrategy": "any"
    },
    {
      "customType": "regex",
      "description": [
        "Track tool versions in Makefiles via '# renovate: datasource=X depName=Y' comments. ",
        "See https://docs.renovatebot.com/configuration-options/#matchstringsstrategy"
      ],
      "managerFilePatterns": [
        "/(^|/)Makefile$/",
        "/\\.mk$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:[^\\n]*?[ \\t]versioning=(?<versioning>\\S+))?[^\\n]*\\n[A-Za-z_][A-Za-z0-9_]*\\s*[:+?]?=\\s*(?<currentValue>v?\\d+\\.\\d+(\\.\\d+)?\\S*)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    }
  ],
  "dependencyDashboardLabels": [
    "no-stale"
  ],
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "description": "Renovate config for projects ivuorinen manages",
  "digest": {
    "enabled": false
  },
  "extends": [
    "config:recommended",
    "customManagers:githubActionsVersions",
    ":enableVulnerabilityAlerts",
    ":gitSignOff",
    ":label(dependencies)",
    ":preserveSemverRanges",
    ":semanticCommits",
    ":timezone(Europe/Helsinki)",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    "security:minimumReleaseAgeNpm",
    "schedule:nonOfficeHours"
  ],
  "git-submodules": {
    "enabled": true
  },
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/*.sops.*",
    "**/.archive/**",
    "**/testdata/**"
  ],
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "addLabels": [
        "type/major"
      ],
      "description": [
        "Label majors, nothing more. No update is marked breaking: a dependency's major is ",
        "not a major of the package that depends on it. The 'chore(deps)!: ' prefix this ",
        "rule used to set cut majors nobody chose: base-configs went from v1 to v4 between ",
        "2026-07-28 and 2026-08-17 on three dependency majors alone. A package's major is ",
        "its owner's call, made in a commit of their own. test/check-commit-messages.mjs ",
        "fails on any prefix that carries '!'."
      ],
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "automerge": true,
      "automergeType": "branch",
      "description": [
        "Automerge non-breaking version bumps via branch strategy. ",
        "'digest' is deliberately excluded: digest updates bypass minimumReleaseAge ",
        "entirely (Renovate pushes them outside filterInternalChecks), so automerging ",
        "them would silently accept a force-moved third-party action tag — the exact ",
        "attack helpers:pinGitHubActionDigests exists to prevent. Third-party digest ",
        "updates therefore raise a reviewable PR; only ivuorinen/actions digests ",
        "automerge, via the trusted-source rule at the end of this array."
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "description": [
        "Exempt git submodules from the global minimumReleaseAge hold. The git-refs ",
        "datasource returns no releaseTimestamp, and minimumReleaseAgeBehaviour defaults ",
        "to 'timestamp-required', so an unexempted submodule update is marked pending ",
        "forever and no branch is ever created. Every other datasource keeps the ",
        "fail-closed 3-day hold."
      ],
      "matchManagers": [
        "git-submodules"
      ],
      "minimumReleaseAge": null
    },
    {
      "commitMessageTopic": "chart {{depName}}",
      "matchDatasources": [
        "helm"
      ]
    },
    {
      "commitMessageTopic": "image {{depName}}",
      "matchDatasources": [
        "docker"
      ]
    },
    {
      "addLabels": [
        "type/minor"
      ],
      "matchUpdateTypes": [
        "minor"
      ]
    },
    {
      "addLabels": [
        "type/patch"
      ],
      "matchUpdateTypes": [
        "patch"
      ]
    },
    {
      "addLabels": [
        "type/digest"
      ],
      "matchUpdateTypes": [
        "digest"
      ]
    },
    {
      "addLabels": [
        "renovate/container"
      ],
      "matchDatasources": [
        "docker"
      ]
    },
    {
      "addLabels": [
        "renovate/helm"
      ],
      "matchDatasources": [
        "helm"
      ]
    },
    {
      "addLabels": [
        "renovate/ansible"
      ],
      "matchDatasources": [
        "galaxy",
        "galaxy-collection"
      ]
    },
    {
      "addLabels": [
        "renovate/terraform"
      ],
      "matchDatasources": [
        "terraform-provider"
      ]
    },
    {
      "addLabels": [
        "renovate/github-release"
      ],
      "matchDatasources": [
        "github-releases",
        "github-tags"
      ]
    },
    {
      "addLabels": [
        "renovate/github-action"
      ],
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitScope": "actions"
    },
    {
      "description": [
        ".nvmrc (nvm manager) and pre-commit hook updates change local tooling and CI, ",
        "never a package's public API, so they get their own 'tooling' scope — 'actions' ",
        "is reserved for GitHub Actions. The default 'deps' scope made semantic-release ",
        "in the consuming repo cut a patch for every Node bump ",
        "(ivuorinen/base-configs#577 and ivuorinen/base-configs-commitlint#196 were ",
        "retitled by hand). semantic-release-config has a release rule for 'deps' only, ",
        "so 'chore(tooling): ' releases nothing. A repo whose .nvmrc does ship to users ",
        "(e.g. a Docker image built from it) overrides this locally."
      ],
      "matchManagers": [
        "nvm",
        "pre-commit"
      ],
      "semanticCommitScope": "tooling"
    },
    {
      "addLabels": [
        "renovate/pip"
      ],
      "matchDatasources": [
        "pypi"
      ]
    },
    {
      "groupName": "devDependencies (non-major)",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ]
    },
    {
      "description": [
        "devDependencies (npm) and require-dev (Composer) never reach a package's ",
        "consumers, so every update to one, major included, gets the 'dev-deps' scope. ",
        "semantic-release-config has a release rule for 'deps' only, so ",
        "'chore(dev-deps): ' releases nothing."
      ],
      "matchDepTypes": [
        "devDependencies",
        "require-dev"
      ],
      "semanticCommitScope": "dev-deps"
    },
    {
      "description": [
        "Re-enable digest updates for ALL GitHub Actions. ",
        "helpers:pinGitHubActionDigests pins every action to a SHA, but the global ",
        "digest.enabled:false would otherwise freeze those pinned SHAs forever when ",
        "a floating tag (e.g. @v1) moves to a new commit. This keeps digests disabled ",
        "for Docker and everything else, while letting all actions stay current. ",
        "Enabling a digest update is not the same as automerging it: third-party ",
        "action digests raise a reviewable PR, and only ivuorinen/actions digests ",
        "inherit automerge from the trusted-source rule at the end of this array."
      ],
      "enabled": true,
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest"
      ]
    },
    {
      "description": [
        "Group the annotated tool pins — Makefile variables and workflow '*_VERSION' env ",
        "vars — into one PR. The workflow paths cover the customManagers:githubActionsVersions ",
        "preset in 'extends': those deps come from the custom.regex manager, not the ",
        "github-actions one, so the actions rules above never match them. Narrower than the ",
        "preset extracts, on purpose: it also reads Gitea/Forgejo workflows and ",
        "workflow-templates, which no repo here uses. Those still update, just ungrouped."
      ],
      "groupName": "development tools",
      "matchFileNames": [
        "**/Makefile",
        "**/*.mk",
        "**/.github/workflows/*.yml",
        "**/.github/workflows/*.yaml",
        "**/action.yml",
        "**/action.yaml"
      ],
      "matchManagers": [
        "custom.regex"
      ]
    },
    {
      "description": [
        "Every ecosystem group below, and the '@ivuorinen packages' group, appends ",
        "' (dev)' to its name for devDependencies and require-dev. The dev-deps rule ",
        "gives dev updates 'chore(dev-deps): ' (no release) while runtime updates keep ",
        "'chore(deps)', and a grouped branch takes its commitMessagePrefix from the ",
        "first upgrade sorted by depName (Renovate's generateBranchConfig). A group ",
        "holding both would title a runtime bump 'chore(dev-deps)' whenever a dev ",
        "package sorted first, and semantic-release would never ship it. groupName is ",
        "compiled as a template per upgrade, so the suffix splits the group into its ",
        "own branch and PR. test/check-commit-messages.mjs asserts every group that can ",
        "mix dependency types carries the suffix."
      ],
      "groupName": "eslint{{#if (or (equals depType 'devDependencies') (equals depType 'require-dev'))}} (dev){{/if}}",
      "matchPackageNames": [
        "/eslint/"
      ]
    },
    {
      "groupName": "illuminate{{#if (or (equals depType 'devDependencies') (equals depType 'require-dev'))}} (dev){{/if}}",
      "matchPackageNames": [
        "/illuminate/"
      ]
    },
    {
      "groupName": "phpstan{{#if (or (equals depType 'devDependencies') (equals depType 'require-dev'))}} (dev){{/if}}",
      "matchPackageNames": [
        "/phpstan/",
        "/larastan/"
      ]
    },
    {
      "groupName": "semantic-release{{#if (or (equals depType 'devDependencies') (equals depType 'require-dev'))}} (dev){{/if}}",
      "matchPackageNames": [
        "/semantic-release/"
      ]
    },
    {
      "groupName": "stylelint{{#if (or (equals depType 'devDependencies') (equals depType 'require-dev'))}} (dev){{/if}}",
      "matchPackageNames": [
        "/stylelint/"
      ]
    },
    {
      "groupName": "tailwind{{#if (or (equals depType 'devDependencies') (equals depType 'require-dev'))}} (dev){{/if}}",
      "matchPackageNames": [
        "/tailwind/"
      ]
    },
    {
      "groupName": "vite{{#if (or (equals depType 'devDependencies') (equals depType 'require-dev'))}} (dev){{/if}}",
      "matchPackageNames": [
        "/vite/"
      ]
    },
    {
      "groupName": "vue{{#if (or (equals depType 'devDependencies') (equals depType 'require-dev'))}} (dev){{/if}}",
      "matchPackageNames": [
        "/vue/"
      ]
    },
    {
      "commitMessagePrefix": "chore(tooling): ",
      "description": [
        "Tool groups, this rule through zizmor. One tool reaches a repo through several ",
        "managers — a mise pin, a pre-commit hook, an Action plus the version its with: ",
        "input installs, a PyPI/npm/Go path — each with its own depName, so Renovate opened ",
        "one PR per source and the pins drifted apart. Each group lists every packageName ",
        "those managers resolve the tool to (mise maps short names to the GitHub repo, the ",
        "github-actions manager maps known with: inputs the same way). The literal ",
        "'chore(tooling): ' is required, not cosmetic: a grouped branch takes its prefix ",
        "from the first upgrade sorted by depName, and these groups mix chore(deps), ",
        "chore(tooling) and chore(actions) members, so the title would follow the alphabet ",
        "and a mise pin would ship as 'chore(deps): ', which releases. Set on the group, ",
        "every member carries it: never a release. That also removes the reason for the ",
        "' (dev)' suffix, which would split an npm devDependency from its own hook. ",
        "group.commitMessageTopic keeps a version in the title: Renovate drops ",
        "commitMessageExtra when members' new versions are spelled differently (an Action ",
        "at v7 and the binary at v2, or a hook tag v1.7.12 and a mise pin 1.7.12), leaving ",
        "a bare 'update goreleaser', so the topic then lists the distinct target versions, ",
        "prettyNewVersion-normalised. When the spellings agree, the extra survives and the ",
        "topic adds nothing. Must stay after the development tools group, which would ",
        "otherwise keep Makefile and workflow pins of these tools, and after every other ",
        "prefixed rule (test/check-commit-messages.mjs asserts the latter): later matching ",
        "rules win."
      ],
      "group": {
        "commitMessageTopic": "{{{groupName}}}{{#unless commitMessageExtra}} to {{#each (distinct (lookupArray upgrades 'prettyNewVersion'))}}{{#unless @first}}, {{/unless}}{{{.}}}{{/each}}{{/unless}}"
      },
      "groupName": "actionlint",
      "matchPackageNames": [
        "github.com/rhysd/actionlint/cmd/actionlint",
        "raven-actions/actionlint",
        "rhysd/actionlint"
      ],
      "semanticCommitScope": "tooling"
    },
    {
      "commitMessagePrefix": "chore(tooling): ",
      "group": {
        "commitMessageTopic": "{{{groupName}}}{{#unless commitMessageExtra}} to {{#each (distinct (lookupArray upgrades 'prettyNewVersion'))}}{{#unless @first}}, {{/unless}}{{{.}}}{{/each}}{{/unless}}"
      },
      "groupName": "checkov",
      "matchPackageNames": [
        "bridgecrewio/checkov",
        "checkov"
      ],
      "semanticCommitScope": "tooling"
    },
    {
      "commitMessagePrefix": "chore(tooling): ",
      "group": {
        "commitMessageTopic": "{{{groupName}}}{{#unless commitMessageExtra}} to {{#each (distinct (lookupArray upgrades 'prettyNewVersion'))}}{{#unless @first}}, {{/unless}}{{{.}}}{{/each}}{{/unless}}"
      },
      "groupName": "cosign",
      "matchPackageNames": [
        "sigstore/cosign",
        "sigstore/cosign-installer"
      ],
      "semanticCommitScope": "tooling"
    },
    {
      "commitMessagePrefix": "chore(tooling): ",
      "group": {
        "commitMessageTopic": "{{{groupName}}}{{#unless commitMessageExtra}} to {{#each (distinct (lookupArray upgrades 'prettyNewVersion'))}}{{#unless @first}}, {{/unless}}{{{.}}}{{/each}}{{/unless}}"
      },
      "groupName": "editorconfig-checker",
      "matchPackageNames": [
        "editorconfig-checker",
        "editorconfig-checker/action-editorconfig-checker",
        "editorconfig-checker/editorconfig-checker",
        "editorconfig-checker/editorconfig-checker.python"
      ],
      "semanticCommitScope": "tooling"
    },
    {
      "commitMessagePrefix": "chore(tooling): ",
      "group": {
        "commitMessageTopic": "{{{groupName}}}{{#unless commitMessageExtra}} to {{#each (distinct (lookupArray upgrades 'prettyNewVersion'))}}{{#unless @first}}, {{/unless}}{{{.}}}{{/each}}{{/unless}}"
      },
      "groupName": "gitleaks",
      "matchPackageNames": [
        "gitleaks/gitleaks",
        "gitleaks/gitleaks-action"
      ],
      "semanticCommitScope": "tooling"
    },
    {
      "commitMessagePrefix": "chore(tooling): ",
      "group": {
        "commitMessageTopic": "{{{groupName}}}{{#unless commitMessageExtra}} to {{#each (distinct (lookupArray upgrades 'prettyNewVersion'))}}{{#unless @first}}, {{/unless}}{{{.}}}{{/each}}{{/unless}}"
      },
      "groupName": "golangci-lint",
      "matchPackageNames": [
        "github.com/golangci/golangci-lint/v*/cmd/golangci-lint",
        "golangci/golangci-lint",
        "golangci/golangci-lint-action"
      ],
      "semanticCommitScope": "tooling"
    },
    {
      "commitMessagePrefix": "chore(tooling): ",
      "group": {
        "commitMessageTopic": "{{{groupName}}}{{#unless commitMessageExtra}} to {{#each (distinct (lookupArray upgrades 'prettyNewVersion'))}}{{#unless @first}}, {{/unless}}{{{.}}}{{/each}}{{/unless}}"
      },
      "groupName": "goreleaser",
      "matchPackageNames": [
        "github.com/goreleaser/goreleaser/v*",
        "goreleaser/goreleaser",
        "goreleaser/goreleaser-action"
      ],
      "semanticCommitScope": "tooling"
    },
    {
      "commitMessagePrefix": "chore(tooling): ",
      "group": {
        "commitMessageTopic": "{{{groupName}}}{{#unless commitMessageExtra}} to {{#each (distinct (lookupArray upgrades 'prettyNewVersion'))}}{{#unless @first}}, {{/unless}}{{{.}}}{{/each}}{{/unless}}"
      },
      "groupName": "gosec",
      "matchPackageNames": [
        "github.com/securego/gosec/v*/cmd/gosec",
        "securego/gosec"
      ],
      "semanticCommitScope": "tooling"
    },
    {
      "commitMessagePrefix": "chore(tooling): ",
      "group": {
        "commitMessageTopic": "{{{groupName}}}{{#unless commitMessageExtra}} to {{#each (distinct (lookupArray upgrades 'prettyNewVersion'))}}{{#unless @first}}, {{/unless}}{{{.}}}{{/each}}{{/unless}}"
      },
      "groupName": "markdownlint-cli",
      "matchPackageNames": [
        "igorshubovych/markdownlint-cli",
        "markdownlint-cli"
      ],
      "semanticCommitScope": "tooling"
    },
    {
      "commitMessagePrefix": "chore(tooling): ",
      "group": {
        "commitMessageTopic": "{{{groupName}}}{{#unless commitMessageExtra}} to {{#each (distinct (lookupArray upgrades 'prettyNewVersion'))}}{{#unless @first}}, {{/unless}}{{{.}}}{{/each}}{{/unless}}"
      },
      "groupName": "markdownlint-cli2",
      "matchPackageNames": [
        "DavidAnson/markdownlint-cli2",
        "DavidAnson/markdownlint-cli2-action",
        "markdownlint-cli2"
      ],
      "semanticCommitScope": "tooling"
    },
    {
      "commitMessagePrefix": "chore(tooling): ",
      "group": {
        "commitMessageTopic": "{{{groupName}}}{{#unless commitMessageExtra}} to {{#each (distinct (lookupArray upgrades 'prettyNewVersion'))}}{{#unless @first}}, {{/unless}}{{{.}}}{{/each}}{{/unless}}"
      },
      "groupName": "ruff",
      "matchPackageNames": [
        "astral-sh/ruff",
        "astral-sh/ruff-action",
        "astral-sh/ruff-pre-commit",
        "ruff"
      ],
      "semanticCommitScope": "tooling"
    },
    {
      "commitMessagePrefix": "chore(tooling): ",
      "group": {
        "commitMessageTopic": "{{{groupName}}}{{#unless commitMessageExtra}} to {{#each (distinct (lookupArray upgrades 'prettyNewVersion'))}}{{#unless @first}}, {{/unless}}{{{.}}}{{/each}}{{/unless}}"
      },
      "groupName": "shellcheck",
      "matchPackageNames": [
        "koalaman/shellcheck",
        "koalaman/shellcheck-precommit",
        "shellcheck-py",
        "shellcheck-py/shellcheck-py"
      ],
      "semanticCommitScope": "tooling"
    },
    {
      "commitMessagePrefix": "chore(tooling): ",
      "group": {
        "commitMessageTopic": "{{{groupName}}}{{#unless commitMessageExtra}} to {{#each (distinct (lookupArray upgrades 'prettyNewVersion'))}}{{#unless @first}}, {{/unless}}{{{.}}}{{/each}}{{/unless}}"
      },
      "groupName": "shfmt",
      "matchPackageNames": [
        "mvdan.cc/sh/v*/cmd/shfmt",
        "mvdan/sh",
        "scop/pre-commit-shfmt"
      ],
      "semanticCommitScope": "tooling"
    },
    {
      "commitMessagePrefix": "chore(tooling): ",
      "group": {
        "commitMessageTopic": "{{{groupName}}}{{#unless commitMessageExtra}} to {{#each (distinct (lookupArray upgrades 'prettyNewVersion'))}}{{#unless @first}}, {{/unless}}{{{.}}}{{/each}}{{/unless}}"
      },
      "groupName": "staticcheck",
      "matchPackageNames": [
        "dominikh/go-tools",
        "dominikh/go-tools/staticcheck",
        "dominikh/staticcheck-action",
        "honnef.co/go/tools/cmd/staticcheck"
      ],
      "semanticCommitScope": "tooling"
    },
    {
      "commitMessagePrefix": "chore(tooling): ",
      "group": {
        "commitMessageTopic": "{{{groupName}}}{{#unless commitMessageExtra}} to {{#each (distinct (lookupArray upgrades 'prettyNewVersion'))}}{{#unless @first}}, {{/unless}}{{{.}}}{{/each}}{{/unless}}"
      },
      "groupName": "syft",
      "matchPackageNames": [
        "anchore/sbom-action",
        "anchore/syft"
      ],
      "semanticCommitScope": "tooling"
    },
    {
      "commitMessagePrefix": "chore(tooling): ",
      "group": {
        "commitMessageTopic": "{{{groupName}}}{{#unless commitMessageExtra}} to {{#each (distinct (lookupArray upgrades 'prettyNewVersion'))}}{{#unless @first}}, {{/unless}}{{{.}}}{{/each}}{{/unless}}"
      },
      "groupName": "trivy",
      "matchPackageNames": [
        "aquasecurity/setup-trivy",
        "aquasecurity/trivy",
        "aquasecurity/trivy-action"
      ],
      "semanticCommitScope": "tooling"
    },
    {
      "commitMessagePrefix": "chore(tooling): ",
      "group": {
        "commitMessageTopic": "{{{groupName}}}{{#unless commitMessageExtra}} to {{#each (distinct (lookupArray upgrades 'prettyNewVersion'))}}{{#unless @first}}, {{/unless}}{{{.}}}{{/each}}{{/unless}}"
      },
      "groupName": "uv",
      "matchPackageNames": [
